---
import Base from '../layouts/Base.astro';
import '../styles/page.css'; // after Base, so these override base.css
import '../styles/cv.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site } from '../data/site';
import { summary, experience, skills, education, interests, emailCode } from '../data/cv';

// "Sep 2021" (en-GB's Intl short month is "Sept")
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmt = (ym: string) => `${MONTHS[Number(ym.slice(5, 7)) - 1]} ${ym.slice(0, 4)}`;
const year = new Date().getFullYear();
---
<Base title={`CV — ${site.name}`} description={`Curriculum vitae of ${site.name}, ${site.role.replace(/\u00a0/g, ' ')}.`}>
  <nav class="bar" aria-label="CV">
    <a class="bar-item" href="/"><span aria-hidden="true">←</span> Home</a>
    <button class="bar-item" type="button" data-print><span class="wide">Download </span>PDF</button>
    <button class="bar-item needs-js" type="button" data-copy-email={emailCode}><span class="wide">Copy </span>email</button>
    <ThemeToggle />
  </nav>

  <main id="main" class="sheet">
    <header class="head fade">
      <div>
        <h1>{site.name}</h1>
        <p class="role">{site.role}</p>
        <p class="focus">Technical Lead at kariera.gr, based in Athens</p>
      </div>
      <dl class="links">
        <div class="needs-js"><dt>email</dt><dd><button class="show-email" type="button" data-email={emailCode}>Show email</button></dd></div>
        <div><dt>web</dt><dd><a href="/">abourazanis.com</a></dd></div>
        {site.socials.map((s) => (
          <div><dt>{s.label.toLowerCase()}</dt><dd><a href={s.href} rel="me">{new URL(s.href).pathname.split('/').filter(Boolean).pop()}</a></dd></div>
        ))}
      </dl>
    </header>

    <div class="cols">
      <div class="primary">
        <section class="part fade" style="--i:1" aria-labelledby="summary">
          <h2 id="summary"><span aria-hidden="true">01</span>Summary</h2>
          <p class="summary">{summary}</p>
        </section>

        <section class="part fade" style="--i:2" aria-labelledby="experience">
          <h2 id="experience"><span aria-hidden="true">02</span>Experience</h2>
          <ol class="timeline">
            {experience.map((r) => (
              <li class:list={['job', { now: !r.end }]}>
                <div class="job-head">
                  <h3>{r.title}<span class="at"> · {r.url ? <a href={r.url}>{r.company}</a> : r.company}</span></h3>
                  <p class="when"><time datetime={r.start}>{fmt(r.start)}</time> – {r.end ? <time datetime={r.end}>{fmt(r.end)}</time> : 'Present'}</p>
                </div>
                {r.about && <p class="about">{r.about}</p>}
                <ul class="points">{r.points.map((p) => <li>{p}</li>)}</ul>
                {r.tags && <p class="tags"><span class="visually-hidden">Stack: </span>{r.tags.join(' · ')}</p>}
              </li>
            ))}
          </ol>
        </section>
      </div>

      <aside class="secondary">
        <section class="part fade" style="--i:3" aria-labelledby="skills">
          <h2 id="skills"><span aria-hidden="true">03</span>Skills</h2>
          <dl class="skills">
            {skills.map((s) => <div><dt>{s.area}</dt><dd>{s.items}</dd></div>)}
          </dl>
        </section>

        <section class="part fade" style="--i:4" aria-labelledby="education">
          <h2 id="education"><span aria-hidden="true">04</span>Education</h2>
          {education.map((e) => (
            <div class="edu">
              <h3>{e.degree}</h3>
              <p>{e.school}<br /><span class="when">{e.years}</span></p>
              {e.note && <p class="note">{e.note}</p>}
            </div>
          ))}
        </section>

        <section class="part fade" style="--i:5" aria-labelledby="interests">
          <h2 id="interests"><span aria-hidden="true">05</span>Off the clock</h2>
          <p class="interests">{interests.map((t, i) => <><span class="nowrap">{t}{i < interests.length - 1 && ' ·'}</span>{' '}</>)}</p>
        </section>
      </aside>
    </div>
  </main>

  <footer class="sheet-foot">
    <p>© {year} {site.name}<span class="sep"> · </span>Prints to a clean A4 page</p>
  </footer>
</Base>

<script>
  import '../scripts/email';
  document.querySelector('[data-print]')?.addEventListener('click', () => print());
</script>
