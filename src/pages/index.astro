---
import '../styles/home.css';
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import Section from '../components/Section.astro';
import GitHubActivity from '../components/GitHubActivity.astro';
import ProjectList from '../components/ProjectList.astro';
import PageFooter from '../components/PageFooter.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
---
<Base>
  <div class="layout">
    <Sidebar />

    <main id="main" class="content">
      <Section id="about" num="01" title="About" class="about">
        <p>I like the unglamorous parts of software: <strong>the parts that have to keep working.</strong> Most of my work has been in fintech, e-learning and booking platforms, where reliability is the feature.</p>
        <p>I started out in 2010 turning designs into HTML, moved into Django and native mobile apps, and over the years settled where I'm most useful: backend architecture and the teams around it. I care about clear domain models, boring deploys and engineers who enjoy coming to work.</p>
        <p class="offclock"><strong>Off the clock</strong>Airplanes&nbsp;· Scale&nbsp;modelling&nbsp;· Lindy&nbsp;Hop</p>
        <div class="actions">
          <a class="btn" href="#contact">Work with me <Icon name="arrow-right" /></a>
          <a class="link" href="/cv/">Read the CV</a>
        </div>
      </Section>

      <GitHubActivity />

      <Section id="projects" num="03" title="Projects" class="projects">
        <ProjectList projects={projects} />
        <a class="link" href="/projects/">All projects</a>
      </Section>

      <Section id="contact" num="04" title="Contact" class="contact">
        <p class="contact-copy">Building something that needs a solid backend? Tell me about it.</p>
        <div class="actions">
          <a class="btn" href="/contact/">Start a conversation <Icon name="arrow-right" /></a>
          <a class="link" href={site.linkedin}>or message me on LinkedIn</a>
        </div>
      </Section>

      <PageFooter />
    </main>
  </div>
</Base>
