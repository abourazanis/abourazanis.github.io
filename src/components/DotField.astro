---
// Engineering-paper dot grid behind the page; dots near the cursor tint teal.
---
<canvas class="field" aria-hidden="true"></canvas>
<span class="field-probe" aria-hidden="true"><i style="color: var(--line)"></i><i style="color: var(--accent)"></i></span>

<style>
  .field {
    position: fixed; inset: 0; z-index: -1;
    width: 100%; height: 100%;
    pointer-events: none;
  }
  .field-probe { position: absolute; width: 0; height: 0; overflow: hidden; }
</style>

<script>
  import '../scripts/field';
</script>
