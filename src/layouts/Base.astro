---
import '@fontsource-variable/archivo/wght.css';
// Preload the Latin subset so text renders in Archivo without a late swap.
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import '../styles/base.css';
import DotField from '../components/DotField.astro';
import { site } from '../data/site';

interface Props { title?: string; description?: string }
const { title = `${site.name} — ${site.role}`, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Browser UI matches the page background (--bg); theme.ts follows the manual toggle -->
    <meta name="theme-color" content="#f7f9fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c1522" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Apply a saved theme before first paint to avoid a flash.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') {
          document.documentElement.dataset.theme = t;
          const c = t === 'dark' ? '#0c1522' : '#f7f9fc';
          document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute('content', c));
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <DotField />
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
